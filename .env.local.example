# Copy this file to .env.local and fill in the values.
# Get them from your Supabase project → Settings → API.

# --- Required for chat (you already have this) ---
GROQ_API_KEY=

# Optional Groq model override
# GROQ_MODEL=llama-3.1-8b-instant

# --- Required for auth + history (Supabase) ---
# Project URL (e.g. https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon public key — safe to ship to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — NEVER expose to the browser. Used only in server routes
# (admin user-create / user-delete). Keep the NEXT_PUBLIC_ prefix OFF.
SUPABASE_SERVICE_ROLE_KEY=

# Internal email domain used to fake username-only login. All accounts are
# stored as `<username>@kong.local` in auth.users; users only ever see/type
# their username. You generally don't need to change this.
# NEXT_PUBLIC_USERNAME_EMAIL_DOMAIN=kong.local
